{
  "id": "worms",
  "name": "Worms",
  "version": "1.0.0",
  "chaosAddonApi": 3,
  "server": "server/index.js",
  "catalogue": {
    "id": "worms",
    "title": "Worms",
    "icon": "🪱",
    "thumbnail": "/games/worms/assets/thumbnail.webp",
    "kind": "heavy",
    "seats": 8,
    "hasStakes": true,
    "launch": {
      "kind": "window",
      "target": "worms"
    },
    "description": "Affrontements multijoueurs dans les salles Worms."
  },
  "description": "Affrontements multijoueurs dans les salles Worms.",
  "icon": "🪱",
  "readiness": {
    "files": [
      {
        "path": "client/worms.js",
        "minBytes": 1
      },
      {
        "path": "client/style.css",
        "minBytes": 1
      }
    ]
  },
  "browser": {
    "window": "client/host-window.js",
    "chat": "client/host-chat.js",
    "gamepads": [
      {
        "mode": "worms-game",
        "profile": {
          "target": "document",
          "axes": {
            "x": {
              "neg": ["ArrowLeft"],
              "pos": ["ArrowRight"]
            },
            "y": {
              "neg": ["ArrowUp"],
              "pos": ["ArrowDown"]
            }
          },
          "buttons": {
            "0": ["Enter"],
            "1": ["Space"],
            "2": ["Backspace"],
            "3": ["KeyC"],
            "4": ["Digit1"],
            "5": ["Digit2"],
            "6": ["Digit3"],
            "7": ["Digit4"],
            "8": ["Digit5"]
          }
        }
      }
    ],
    "locales": "client/host-locales.json"
  },
  "windowGeometry": {
    "left": 15,
    "top": 8,
    "width": 60,
    "height": 72
  },
  "development": {
    "format": ["addons/games/worms/client/worms-*.js", "addons/games/worms/tests/{client-media,worms-*}.test.js"],
    "lint": {
      "strict": [
        "addons/games/worms/client/worms-catalog.js",
        "addons/games/worms/client/worms-round.js",
        "addons/games/worms/tests/worms-catalog.test.js",
