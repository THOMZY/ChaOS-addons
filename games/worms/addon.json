        "addons/games/worms/client/worms-actions.js",
        "addons/games/worms/tests/worms-actions.test.js",
        "addons/games/worms/client/worms-input.js",
        "addons/games/worms/tests/worms-input.test.js",
        "addons/games/worms/client/worms-menu-view.js",
        "addons/games/worms/tests/worms-menu-view.test.js",
        "addons/games/worms/client/worms-game-view.js",
        "addons/games/worms/tests/worms-game-view.test.js",
        "addons/games/worms/client/worms-hud.js",
